{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ver.cy/schema/deployment-profile/1.0.0",
  "title": "Vercy deployment profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "representation", "carrier", "interfaces", "template", "bootstrap", "validation"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "representation": { "type": "string", "minLength": 1 },
    "carrier": { "type": "string", "minLength": 1 },
    "interfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "template": { "type": "string", "format": "uri" },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agents_md_location", "discovery"],
      "properties": {
        "agents_md_location": { "type": "string" },
        "discovery": { "type": "string" }
      }
    },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}

