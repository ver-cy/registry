{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ver.cy/schema/adapter-descriptor/1.0.0",
  "title": "Vercy representation, carrier or interface descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "axis", "name", "capabilities", "read", "validation"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "axis": { "enum": ["representation", "carrier", "interface"] },
    "name": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "logical_mapping": {
      "type": "object",
      "properties": {
        "lossless": { "type": "boolean" },
        "canonicalization": { "type": "string", "format": "uri" },
        "node_mapping": { "type": "object" }
      }
    },
    "read": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "query": { "type": "array", "items": { "type": "string" } },
    "write": { "type": "array", "items": { "type": "string" } },
    "transactions": { "type": "string" },
    "pagination": { "type": "string" },
    "authentication": { "type": "string" },
    "error_model": { "type": "string" },
    "history": { "type": "string" },
    "backup": { "type": "string" },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "examples": { "type": "array", "items": { "type": "string", "format": "uri" } }
  },
  "allOf": [
    {
      "if": { "properties": { "axis": { "const": "representation" } } },
      "then": { "required": ["logical_mapping"] }
    }
  ]
}

