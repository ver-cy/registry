{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ver.cy/schema/patch-package/1.0.0",
  "title": "Vercy meta-model patch package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "namespace", "owner", "target", "operations", "validation"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "namespace": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version_range", "fingerprint"],
      "properties": {
        "catalogue_id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
        "version_range": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^sf1:[0-9A-Fa-f]{8,}$" }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path", "precondition"],
        "properties": {
          "op": { "enum": ["add", "refine", "deprecate", "retire", "bind-master", "bind-policy"] },
          "path": { "type": "string", "pattern": "^/" },
          "precondition": { "type": "object" },
          "value": {},
          "reason": { "type": "string" }
        }
      }
    },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "migration": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "result_fingerprint": { "type": "string", "pattern": "^sf1:[0-9A-Fa-f]{8,}$" }
  }
}

