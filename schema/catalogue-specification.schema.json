{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ver.cy/schema/catalogue-specification/1.0.0",
  "title": "Vercy catalogue meta-model specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "classification", "versioning", "structure", "service"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "identity": { "$ref": "#/$defs/identity" },
    "classification": { "$ref": "#/$defs/classification" },
    "versioning": { "$ref": "#/$defs/versioning" },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundles"],
      "properties": { "bundles": { "type": "array", "items": { "$ref": "#/$defs/bundle" } } }
    },
    "service": { "$ref": "#/$defs/service" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "catalogueId": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "uri": { "type": "string", "format": "uri" },
    "stringSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "csn", "name", "summary", "namespace", "owner", "publisher", "license", "lifecycle"],
      "properties": {
        "catalogue_id": { "$ref": "#/$defs/catalogueId" },
        "csn": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "$ref": "#/$defs/stringSet" },
        "summary": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "dimension": { "$ref": "#/$defs/catalogueId" },
        "owner": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "stewards": { "$ref": "#/$defs/stringSet" },
        "license": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["draft", "active", "deprecated", "retired"] },
        "specification_repository": { "$ref": "#/$defs/uri" },
        "fingerprint": { "type": "string", "pattern": "^sf1:[0-9A-Fa-f]{8,}$" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "category", "industries", "domains", "tags"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "industries": { "$ref": "#/$defs/stringSet" },
        "domains": { "$ref": "#/$defs/stringSet" },
        "tags": { "$ref": "#/$defs/stringSet" }
      }
    },
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "immutable_url", "history"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "immutable_url": { "$ref": "#/$defs/uri" },
        "latest_url": { "$ref": "#/$defs/uri" },
        "compatibility": { "enum": ["exact", "same-major", "declared-range"] },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "url"],
            "properties": {
              "version": { "$ref": "#/$defs/semver" },
              "url": { "$ref": "#/$defs/uri" },
              "migration": { "$ref": "#/$defs/uri" }
            }
          }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "target"],
      "properties": {
        "relation": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "masterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "system", "authority", "direction"],
      "properties": {
        "dataset": { "type": "string", "minLength": 1 },
        "system": { "type": "string", "minLength": 1 },
        "authority": { "enum": ["authoritative", "mirror", "derived"] },
        "direction": { "enum": ["inbound", "outbound", "internal"] },
        "freshness": { "type": "string", "minLength": 1 }
      }
    },
    "nodeBase": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "child_model_refs": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "master_bindings": { "type": "array", "items": { "$ref": "#/$defs/masterBinding" } },
        "policy_refs": { "$ref": "#/$defs/stringSet" },
        "access_rule_refs": { "$ref": "#/$defs/stringSet" }
      }
    },
    "question": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["required", "answer_shape"],
          "properties": {
            "required": { "type": "boolean" },
            "answer_shape": { "type": "object", "minProperties": 1, "additionalProperties": true }
          }
        }
      ]
    },
    "artifact": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["kind", "cardinality", "validation"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "cardinality": { "enum": ["singular", "serial"] },
            "serial_rules": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prefix", "ordering"],
              "properties": {
                "prefix": { "type": "string" },
                "suffix": { "type": "string" },
                "ordering": { "type": "string", "minLength": 1 },
                "partitioning": { "type": "string" }
              }
            },
            "retention": { "type": "string" },
            "sensitivity": { "type": "string" },
            "validation": { "$ref": "#/$defs/stringSet" },
            "representation_refs": { "$ref": "#/$defs/stringSet" }
          }
        }
      ]
    },
    "finding": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["questions", "artifacts"],
          "properties": {
            "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
            "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
          }
        }
      ]
    },
    "layer": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["findings"],
          "properties": { "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } } }
        }
      ]
    },
    "bundle": {
      "allOf": [
        { "$ref": "#/$defs/nodeBase" },
        {
          "type": "object",
          "required": ["layers"],
          "properties": { "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } } }
        }
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "responsibilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "responsibilities": { "$ref": "#/$defs/stringSet" }
      }
    },
    "accessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "roles", "actions", "scopes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "effect": { "enum": ["allow", "deny"] },
        "roles": { "$ref": "#/$defs/stringSet" },
        "actions": { "type": "array", "uniqueItems": true, "items": { "enum": ["read", "add", "edit", "delete", "retire", "review", "approve", "administer"] } },
        "scopes": { "$ref": "#/$defs/stringSet" },
        "purpose": { "type": "string" },
        "exceptions": { "$ref": "#/$defs/stringSet" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canon", "artifact_requirements", "policies", "processes", "operations", "roles", "access", "validation", "agent_bootstrap"],
      "properties": {
        "canon": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "patches": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "standards": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "artifact_requirements": { "type": "array", "items": { "type": "object", "minProperties": 1 } },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "processes": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["read", "add", "edit", "delete", "retire"],
          "properties": {
            "read": { "$ref": "#/$defs/stringSet" },
            "add": { "$ref": "#/$defs/stringSet" },
            "edit": { "$ref": "#/$defs/stringSet" },
            "delete": { "$ref": "#/$defs/stringSet" },
            "retire": { "$ref": "#/$defs/stringSet" }
          }
        },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "access": { "type": "array", "items": { "$ref": "#/$defs/accessRule" } },
        "imports": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "exports": { "$ref": "#/$defs/stringSet" },
        "validation": { "$ref": "#/$defs/stringSet" },
        "observability": { "$ref": "#/$defs/stringSet" },
        "security_privacy": { "$ref": "#/$defs/stringSet" },
        "locales": { "$ref": "#/$defs/stringSet" },
        "agent_bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["agents_md", "ai_instruction"],
          "properties": {
            "agents_md": { "$ref": "#/$defs/uri" },
            "ai_instruction": { "$ref": "#/$defs/uri" }
          }
        },
        "supported_deployment_profiles": { "$ref": "#/$defs/stringSet" }
      }
    }
  }
}

